<Window x:Class="STRELA_MED.Views.AddEmployeeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Добавление сотрудника" Height="350" Width="400"
        WindowStartupLocation="CenterScreen">

    <StackPanel Margin="20">
        <TextBlock Text="ФИО сотрудника:" FontWeight="Bold" Margin="0,5,0,0"/>
        <TextBox x:Name="NameInput" Margin="0,0,0,10" Height="25"/>

        <TextBlock Text="Роль:" FontWeight="Bold" Margin="0,5,0,0"/>
        <TextBox x:Name="RoleInput" Margin="0,0,0,10" Height="25"/>

        <TextBlock Text="ID пользователя:" FontWeight="Bold" Margin="0,5,0,0"/>
        <TextBox x:Name="UserIdInput" Margin="0,0,0,10" Height="25"/>

        <Button Content="Сохранить" Click="Save_Click" 
                Background="#27AE60" Foreground="White" 
                Height="40" Margin="0,20,0,0" Cursor="Hand"/>
    </StackPanel>
</Window>