<UserControl x:Class="STRELA_MED.Views.EmployeeListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="White">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
            <Button x:Name="BtnAdd" Content="➕ Добавить" Command="{Binding AddEmployeeCommand}" 
                    Width="120" Height="30" Margin="0,0,10,0" Background="#27AE60" Foreground="White"
                    Cursor="Hand"/>
            <Button x:Name="BtnDelete" Content="🗑 Уволить" Command="{Binding DeleteEmployeeCommand}" 
                    Width="120" Height="30" Margin="0,0,10,0" Background="#C0392B" Foreground="White"
                    Cursor="Hand"/>
            <Button Content="🔄 Обновить" Command="{Binding RefreshCommand}" 
                    Width="120" Height="30" Background="#2980B9" Foreground="White"
                    Cursor="Hand"/>
            <TextBlock Text="Искать по:" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <ComboBox SelectedIndex="{Binding SelectedSearchIndex}" Width="120" Margin="0,0,10,0">
                <ComboBoxItem Content="Фамилии"/>
                <ComboBoxItem Content="Должности"/>
            </ComboBox>

            <TextBox Width="250" Height="25" 
             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
        </StackPanel>

        <DataGrid ItemsSource="{Binding Employees}" 
          SelectedItem="{Binding SelectedEmployee}" 
          AutoGenerateColumns="False" 
          IsReadOnly="True" 
          Grid.Row="1" Margin="10">

            <DataGrid.InputBindings>
                <MouseBinding MouseAction="LeftDoubleClick" 
                      Command="{Binding OpenCardCommand}" />
            </DataGrid.InputBindings>

            <DataGrid.Columns>
                <DataGridTextColumn Header="Фамилия" Binding="{Binding LastName}" Width="*"/>
                <DataGridTextColumn Header="Имя" Binding="{Binding FirstName}" Width="*"/>
                <DataGridTextColumn Header="Отчество" Binding="{Binding MiddleName}" Width="*"/>
                <DataGridTextColumn Header="Дата рождения" Binding="{Binding BirthDateDisplay}" Width="120"/>
                <DataGridTextColumn Header="Должность" Binding="{Binding Position}" Width="2*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>