<UserControl x:Class="STRELA_MED.Views.EmployeeListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="White">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
            <Button Content="➕ Добавить" Command="{Binding AddEmployeeCommand}" 
                    Width="120" Height="30" Margin="0,0,10,0" Background="#27AE60" Foreground="White"
                    Cursor="Hand"/>
            <Button Content="🗑 Уволить" Command="{Binding DeleteEmployeeCommand}" 
                    Width="120" Height="30" Margin="0,0,10,0" Background="#C0392B" Foreground="White"
                    Cursor="Hand"/>
            <Button Content="🔄 Обновить" Command="{Binding RefreshCommand}" 
                    Width="120" Height="30" Background="#2980B9" Foreground="White"
                    Cursor="Hand"/>
        </StackPanel>

        <DataGrid Grid.Row="1" 
                  ItemsSource="{Binding Employees}" 
                  SelectedItem="{Binding SelectedEmployee}"
                  AutoGenerateColumns="False" 
                  CanUserAddRows="False"
                  IsReadOnly="True"
                  GridLinesVisibility="Horizontal"
                  RowHeight="35"
                  HorizontalGridLinesBrush="#E0E0E0"
                  HeadersVisibility="Column">

            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                <DataGridTextColumn Header="ФИО сотрудника" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="Роль" Binding="{Binding Role}" Width="150"/>
                <DataGridTextColumn Header="ID Пользователя" Binding="{Binding UserId}" Width="120"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>