<Window x:Class="STRELA_MED.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:STRELA_MED.ViewModels"
        xmlns:views="clr-namespace:STRELA_MED.Views"
        xmlns:vmodels="clr-namespace:STRELA_MED.ViewModels"
        mc:Ignorable="d"
        Title="АИС Паспорт здоровья - ПО Стрела" Height="750" Width="1200"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style x:Key="MenuButtonStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property="Margin" Value="0,5"/>
            <Setter Property="Padding" Value="15,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderThickness" Value="0"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#34495E"/>
                </Trigger>

                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="#1ABC9C"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <DataTemplate DataType="{x:Type vmodels:EmployeeListViewModel}">
            <views:EmployeeListView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vmodels:MedicalExamsViewModel}">
            <views:MedicalExamsView />
        </DataTemplate>
        
        <DataTemplate DataType="{x:Type vmodels:InventoryViewModel}">
            <views:InventoryView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vmodels:ReportsViewModel}">
            <views:ReportsView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vmodels:MyExamsViewModel}">
            <views:MyExamsView />
        </DataTemplate>

    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Background="#2C3E50" Grid.Column="0">
            <StackPanel Margin="10">
                <TextBlock Text="СТРЕЛА-МЕД" Foreground="White" FontSize="24" 
               FontWeight="Bold" Margin="0,20,0,40" HorizontalAlignment="Center"/>

                <TextBlock Text="Вы вошли как:" Foreground="Gray" FontSize="11"/>
                <StackPanel Margin="0,5,0,10">
                    <TextBlock Text="{Binding CurrentUser.LastName}" 
                       Foreground="White" FontWeight="Bold" FontSize="14" 
                       TextWrapping="Wrap" HorizontalAlignment="Center"/>

                    <TextBlock Text="{Binding CurrentUser.FirstName}" 
                       Foreground="White" FontWeight="Bold" FontSize="14" 
                       TextWrapping="Wrap" HorizontalAlignment="Center"/>

                    <TextBlock Text="{Binding CurrentUser.MiddleName}" 
                       Foreground="White" FontWeight="Bold" FontSize="14" 
                       TextWrapping="Wrap" HorizontalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="{Binding CurrentUser.Role}" Foreground="#F1C40F" 
               FontSize="12" Margin="0,0,0,10"/>

                <Separator Margin="0,5,0,15" Opacity="0.3"/>

                <StackPanel x:Name="AdminPanel">
                    <RadioButton Content="🔔 Мои уведомления" 
                     GroupName="MainMenu"
                     Command="{Binding ShowNotificationsCommand}"
                     Style="{StaticResource MenuButtonStyle}"
                     Cursor="Hand"/>
                    
                    <RadioButton Content="👥 Реестр персонала" 
                     GroupName="MainMenu"
                     Command="{Binding ShowEmployeesCommand}"
                     Style="{StaticResource MenuButtonStyle}"
                     IsChecked="True" />

                    <RadioButton Content="🏥 Медосмотры" 
                     GroupName="MainMenu"
                     Command="{Binding ShowMedicalExamsCommand}" 
                     Style="{StaticResource MenuButtonStyle}"
                     Cursor="Hand"/>

                    <RadioButton Content="📦 Склад / Аптека" 
                     GroupName="MainMenu"
                     Command="{Binding ShowInventoryCommand}"
                     Style="{StaticResource MenuButtonStyle}"
                     Cursor="Hand"/>

                    <RadioButton Content="📊 Отчетность" 
                     GroupName="MainMenu"
                     Command="{Binding ShowReportsCommand}"
                     Style="{StaticResource MenuButtonStyle}"
                     Cursor="Hand"/>

                    <RadioButton Content="📋 Мои осмотры" 
                     GroupName="MainMenu"
                     Command="{Binding ShowMyExamsCommand}"
                     Style="{StaticResource MenuButtonStyle}"
                     Cursor="Hand"/>
                </StackPanel>

                <StackPanel x:Name="UserPanel" Visibility="Collapsed">
                    <RadioButton Content="👤 Мой профиль" 
                     GroupName="MainMenu"
                     Command="{Binding ShowMyProfileCommand}"
                     Style="{StaticResource MenuButtonStyle}"
                     IsChecked="True"
                     Cursor="Hand"/>

                    <RadioButton Content="📋 Мои осмотры" 
                     GroupName="MainMenu"
                     Command="{Binding ShowMyExamsCommand}"
                     Style="{StaticResource MenuButtonStyle}"
                     Cursor="Hand"/>

                    <RadioButton Content="🔔 Уведомления" 
                     GroupName="MainMenu"
                     Command="{Binding ShowNotificationsCommand}"
                     Style="{StaticResource MenuButtonStyle}"
                     Cursor="Hand"/>
                </StackPanel>

                <Separator Margin="0,5,0,15" Opacity="0.3"/>

                <Button Content="🔄 Сменить аккаунт" 
            Click="Logout_Click"
            Background="#34495E" Foreground="White" 
            Height="35" Margin="0,5" Cursor="Hand" BorderThickness="0">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="5"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <Button Content="❌ Закрыть систему" 
            Click="Shutdown_Click"
            Background="#C0392B" Foreground="White" 
            Height="35" Margin="0,5" Cursor="Hand" BorderThickness="0">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="5"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Border>

        <ContentControl Grid.Column="1" Content="{Binding CurrentView}" />
    </Grid>
</Window>