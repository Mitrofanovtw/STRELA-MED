<Window x:Class="STRELA_MED.Views.ViewNotificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Просмотр уведомления" Height="250" Width="350" 
        WindowStartupLocation="CenterOwner"
        Background="#F5F5F5">
    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="Сообщение:" FontWeight="Bold" Foreground="#666" Margin="0,0,0,10"/>
            <Border Background="White" CornerRadius="5" Padding="10" BorderBrush="#DDD" BorderThickness="1">
                <TextBlock x:Name="txtFullMessage" 
                           TextWrapping="Wrap" 
                           FontSize="14" 
                           LineHeight="20"/>
            </Border>
            <Button Content="Закрыть" Click="Close_Click" HorizontalAlignment="Right" 
                    Margin="0,15,0,0" Width="80" Height="25"/>
        </StackPanel>
    </Grid>
</Window>