<Window x:Class="STRELA_MED.Views.EmployeeCardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Личная карточка сотрудника" Height="650" Width="450" Background="#ECF0F1" WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="ЛИЧНАЯ КАРТОЧКА" FontSize="20" FontWeight="Bold" Foreground="#2C3E50" HorizontalAlignment="Center" Margin="0,0,0,20"/>

            <Border Background="White" CornerRadius="10" Padding="15">
                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="420">
                    <StackPanel>
                        <Label Content="Фамилия:" Foreground="Gray"/>
                        <TextBox Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}" FontSize="16" Margin="0,0,0,10"/>

                        <Label Content="Имя:" Foreground="Gray"/>
                        <TextBox Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}" FontSize="16" Margin="0,0,0,10"/>

                        <Label Content="Отчество:" Foreground="Gray"/>
                        <TextBox Text="{Binding MiddleName, UpdateSourceTrigger=PropertyChanged}" FontSize="16" Margin="0,0,0,10"/>

                        <Label Content="Должность:" Foreground="Gray"/>
                        <TextBox Text="{Binding Position, UpdateSourceTrigger=PropertyChanged}" FontSize="16" Margin="0,0,0,10"/>

                        <Label Content="Дата рождения (просмотр):" Foreground="Gray"/>
                        <TextBlock Text="{Binding BirthDateDisplay}" FontSize="16" Margin="5,0,0,10" Foreground="#7F8C8D"/>

                        <Separator Margin="0,10"/>

                        <Label Content="Хронические заболевания:" Foreground="Red" FontWeight="Bold"/>
                        <TextBox Text="{Binding ChronicDiseases, UpdateSourceTrigger=PropertyChanged}" 
                                 TextWrapping="Wrap" AcceptsReturn="True" Height="60" FontSize="14" Margin="0,5"/>

                        <Label Content="История медкомиссий:" Foreground="#2980B9" FontWeight="Bold" Margin="0,10,0,0"/>
                        <TextBlock Text="{Binding MedicalHistory}" TextWrapping="Wrap" FontSize="14" FontStyle="Italic" Margin="5,0,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Grid Margin="0,20,0,0">
                <Button Content="💾 Сохранить" HorizontalAlignment="Left" Width="120" Height="35" 
                        Background="#27AE60" Foreground="White" FontWeight="Bold" Click="SaveEdit_Click"/>

                <Button Content="Закрыть" IsCancel="True" HorizontalAlignment="Right" Width="100" Height="35"/>
            </Grid>
        </StackPanel>
    </Grid>
</Window>