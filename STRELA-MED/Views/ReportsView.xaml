<UserControl x:Class="STRELA_MED.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F4F7F6">
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="АНАЛИТИЧЕСКИЙ ОТЧЕТ" FontSize="24" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,30"/>

        <UniformGrid Grid.Row="1" Columns="2" Rows="2" VerticalAlignment="Top">
            <Border Background="White" Margin="10" CornerRadius="10" Padding="20" Effect="{DynamicResource DropShadow}">
                <StackPanel>
                    <TextBlock Text="Всего сотрудников" Foreground="Gray" FontSize="14"/>
                    <TextBlock Text="{Binding TotalEmployees}" FontSize="36" FontWeight="Bold" Foreground="#2980B9"/>
                </StackPanel>
            </Border>

            <Border Background="White" Margin="10" CornerRadius="10" Padding="20">
                <StackPanel>
                    <TextBlock Text="Пройдено медосмотров" Foreground="Gray" FontSize="14"/>
                    <TextBlock Text="{Binding CompletedExams}" FontSize="36" FontWeight="Bold" Foreground="#27AE60"/>
                </StackPanel>
            </Border>

            <Border Background="White" Margin="10" CornerRadius="10" Padding="20">
                <StackPanel>
                    <TextBlock Text="Ожидают осмотра" Foreground="Gray" FontSize="14"/>
                    <TextBlock Text="{Binding PendingExams}" FontSize="36" FontWeight="Bold" Foreground="#E67E22"/>
                </StackPanel>
            </Border>

            <Border Background="White" Margin="10" CornerRadius="10" Padding="20">
                <StackPanel>
                    <TextBlock Text="Дефицит товаров (склад)" Foreground="Gray" FontSize="14"/>
                    <TextBlock Text="{Binding LowStockItems}" FontSize="36" FontWeight="Bold" Foreground="#C0392B"/>
                </StackPanel>
            </Border>

        </UniformGrid>
        <Button Content="💾 Сформировать полный отчет (PDF)" 
            Grid.Row="2" 
            Click="GeneratePdfReport_Click"
            Width="350" Height="45" 
            HorizontalAlignment="Center" 
            Margin="0,20,0,0"
            Background="#2C3E50" Foreground="White" FontWeight="Bold">
            <Button.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="5"/>
                </Style>
            </Button.Resources>
        </Button>
    </Grid>
</UserControl>