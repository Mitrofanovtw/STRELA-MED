<UserControl x:Class="STRELA_MED.Views.MedicalExamsView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:STRELA_MED.Views"
        mc:Ignorable="d">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
            <TextBlock Text="Поиск сотрудника:" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBox x:Name="SearchEmployeeExams" Width="300" Height="25" />
            <Button Content="🔍 Найти историю" Width="150" Margin="10,0,0,0" 
                Background="#2980B9" Foreground="White" Click="SearchExams_Click"/>

            <Button Content="➕ Вызвать на медосмотр" 
            Click="CallToExam_Click" 
            Background="#E67E22" Foreground="White" 
            FontWeight="Bold" Width="200" Height="35" Margin="10,0,0,0"/>
        </StackPanel>

        <DataGrid x:Name="ExamsGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" 
              Visibility="Collapsed">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Дата осмотра" Binding="{Binding ExamDate, StringFormat=\{0:dd.MM.yyyy\}}" Width="120"/>
                <DataGridTextColumn Header="Тип" Binding="{Binding ExamType}" Width="150"/>
                <DataGridTextColumn Header="Врач" Binding="{Binding DoctorName}" Width="200"/>
                <DataGridTextColumn Header="Результат" Binding="{Binding Result}" Width="*"/>
                <DataGridTextColumn Header="Срок до" Binding="{Binding ValidUntil, StringFormat=\{0:dd.MM.yyyy\}}" Width="120"/>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock x:Name="EmptyStateText" Grid.Row="1" Text="Введите фамилию для поиска медицинских записей" 
               HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="Gray" FontSize="16"/>
    </Grid>
</UserControl>
