<UserControl x:Class="STRELA_MED.Views.MedicalExamsView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:STRELA_MED.Views"
        mc:Ignorable="d">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
            <TextBlock Text="Поиск сотрудника:" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBox x:Name="SearchEmployeeExams" Width="300" Height="25" 
                     TextChanged="SearchEmployeeExams_TextChanged"/>
            <Button Content="🔍 Найти историю" Width="150" Margin="10,0,0,0" 
                Background="#2980B9" Foreground="White" Click="SearchExams_Click"/>

            <Button x:Name="BtnCallToExam" Content="➕ Вызвать на медосмотр" 
            Click="CallToExam_Click" 
            Background="#E67E22" Foreground="White" 
            FontWeight="Bold" Width="200" Height="35" Margin="10,0,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" BorderBrush="#BDC3C7" BorderThickness="1" CornerRadius="5">
            <DataGrid x:Name="ExamsGrid" 
          Grid.Row="1" 
          AutoGenerateColumns="False" 
          CanUserAddRows="False"
          IsReadOnly="True"
          Background="White" 
          BorderBrush="#BDC3C7" 
          BorderThickness="1" 
          GridLinesVisibility="All" 
          HorizontalGridLinesBrush="#ECF0F1" 
          VerticalGridLinesBrush="#ECF0F1"
          RowHeight="35"
          AlternatingRowBackground="#F9FAFB">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#2980B9"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="Padding" Value="10,5"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                        <Setter Property="BorderBrush" Value="#BDC3C7"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Фамилия" Binding="{Binding Employee.LastName}" Width="*"/>
                    <DataGridTextColumn Header="Имя" Binding="{Binding Employee.FirstName}" Width="*"/>
                    <DataGridTextColumn Header="Тип осмотра" Binding="{Binding ExamType}" Width="1.2*"/>
                    <DataGridTextColumn Header="Дата" Binding="{Binding ExamDate, StringFormat={}{0:dd.MM.yyyy}}" Width="100"/>
                    <DataGridTextColumn Header="Результат" Binding="{Binding Result}" Width="1.5*"/>
                    <DataGridTextColumn Header="Годен до" Binding="{Binding ValidUntil, StringFormat={}{0:dd.MM.yyyy}}" Width="100"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <TextBlock x:Name="EmptyStateText" Grid.Row="1" Text="Введите фамилию для поиска медицинских записей" 
               HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="Gray" FontSize="16"/>
    </Grid>
</UserControl>
