<UserControl x:Class="STRELA_MED.Views.MyProfileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="White">
    <Grid Margin="30">
        <StackPanel MaxWidth="500" HorizontalAlignment="Left">
            <TextBlock Text="ЛИЧНЫЙ ПРОФИЛЬ СОТРУДНИКА" FontSize="22" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,25"/>

            <Border Background="#F9F9F9" CornerRadius="10" Padding="20" BorderBrush="#DCDDE1" BorderThickness="1">
                <StackPanel>
                    <Label Content="ФИО:" Foreground="Gray" FontSize="12"/>
                    <TextBlock Text="{Binding FullName}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,15"/>

                    <Label Content="Должность:" Foreground="Gray" FontSize="12"/>
                    <TextBlock Text="{Binding Position}" FontSize="16" Margin="0,0,0,15"/>

                    <Label Content="Дата рождения:" Foreground="Gray" FontSize="12"/>
                    <TextBlock Text="{Binding BirthDate, StringFormat={}{0:dd.MM.yyyy}}" FontSize="16" Margin="0,0,0,15"/>

                    <Separator Margin="0,10"/>

                    <Label Content="Медицинские отметки (Хронические заболевания):" Foreground="#C0392B" FontWeight="Bold" FontSize="12"/>
                    <TextBlock Text="{Binding ChronicDiseases}" TextWrapping="Wrap" FontSize="14" FontStyle="Italic" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>

            <TextBlock Text="* Если данные неверны, обратитесь в отдел кадров или медпункт." 
                       Foreground="Gray" FontSize="11" Margin="0,15,0,0" FontStyle="Italic"/>
        </StackPanel>
    </Grid>
</UserControl>