<UserControl x:Class="STRELA_MED.Views.MyProfileView"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             Background="White">
    <Grid Margin="30">
        <StackPanel MaxWidth="800" HorizontalAlignment="Left">
            <TextBlock Text="ЛИЧНЫЙ ПРОФИЛЬ СОТРУДНИКА" FontSize="22" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,25"/>

            <Border Background="#F9F9F9" CornerRadius="10" Padding="25" BorderBrush="#DCDDE1" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column = "0" Margin="0,0,30,0" VerticalAlignment="Top">
                        <Border Width="180" Height="180" CornerRadius="10" BorderBrush="#DCDDE1" BorderThickness="2" Background="White" ToolTip="Ваше фото">
                            <Image x:Name="ProfileImage" 
                                   Source="{Binding PhotoPath, TargetNullValue='pack://application:,,,/Resources/default_user.png'}" 
                                   Stretch="UniformToFill">
                                <Image.Clip>
                                    <RectangleGeometry Rect="0,0,180,180" RadiusX="8" RadiusY="8"/>
                                </Image.Clip>
                            </Image>
                        </Border>

                        <Button Content="📷 Изменить фото" 
                                Click="ChangePhoto_Click" 
                                Margin="0,15,0,0" 
                                Background="#3498DB" 
                                Foreground="White" 
                                FontWeight="SemiBold"
                                Height="30"
                                Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="5"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <Label Content="ФИО:" Foreground="Gray" FontSize="12"/>
                        <TextBlock Text="{Binding FullName}" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,15" Foreground="#2C3E50"/>

                        <Label Content="Должность:" Foreground="Gray" FontSize="12"/>
                        <TextBlock Text="{Binding Position}" FontSize="16" Margin="0,0,0,15"/>

                        <Label Content="Дата рождения:" Foreground="Gray" FontSize="12"/>
                        <TextBlock Text="{Binding BirthDate, StringFormat={}{0:dd.MM.yyyy}}" FontSize="16" Margin="0,0,0,15"/>

                        <Separator Margin="0,10"/>

                        <Label Content="Медицинские отметки (Хронические заболевания):" Foreground="#C0392B" FontWeight="Bold" FontSize="12"/>
                        <TextBlock Text="{Binding ChronicDiseases}" TextWrapping="Wrap" FontSize="14" FontStyle="Italic" Margin="0,5,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock Text="* Если данные неверны, обратитесь в отдел кадров или медпункт." 
                       Foreground="Gray" FontSize="11" Margin="0,15,0,0" FontStyle="Italic"/>
        </StackPanel>
    </Grid>
</UserControl>