<Window x:Class="STRELA_MED.Views.EmployeeAnalyticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
        Title="Аналитическая карта здоровья" Height="650" Width="900"
        WindowStartupLocation="CenterScreen" Background="#FDFDFD">

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#2980B9" CornerRadius="8" Padding="20" Margin="0,0,0,20">
            <StackPanel>
                <TextBlock x:Name="txtFullName" FontSize="22" FontWeight="Bold" Foreground="White"/>
                <TextBlock x:Name="txtPosition" FontSize="14" Foreground="#E1F5FE" Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Margin="10,0,10,10">
            <lvc:CartesianChart LegendLocation="Top" 
                        DisableAnimations="False" 
                        Hoverable="True"
                        DataTooltip="{x:Null}">

                <lvc:CartesianChart.Series>
                    <lvc:LineSeries Title="АД Систол." 
                           Values="{Binding SysPressureValues}" 
                           Stroke="#2980B9" Fill="Transparent" 
                           PointGeometrySize="8" />

                    <lvc:LineSeries Title="АД Диастол." 
                           Values="{Binding DiaPressureValues}" 
                           Stroke="#3498DB" Fill="Transparent" 
                           PointGeometrySize="8" />

                    <lvc:LineSeries Title="Пульс" 
                           Values="{Binding PulseValues}" 
                           Stroke="#E74C3C" Fill="Transparent" 
                           PointGeometrySize="8" />
                </lvc:CartesianChart.Series>

                <lvc:CartesianChart.AxisX>
                    <lvc:Axis Title="Дата" Labels="{Binding DateLabels}">
                        <lvc:Axis.Separator>
                            <lvc:Separator Step="1" StrokeThickness="0" />
                        </lvc:Axis.Separator>
                    </lvc:Axis>
                </lvc:CartesianChart.AxisX>

                <lvc:CartesianChart.AxisY>
                    <lvc:Axis Title="Значение" MinValue="0">
                        <lvc:Axis.Separator>
                            <lvc:Separator StrokeDashArray="2" Stroke="#CFD8DC" />
                        </lvc:Axis.Separator>
                    </lvc:Axis>
                </lvc:CartesianChart.AxisY>
            </lvc:CartesianChart>
        </Grid>
    </Grid>
</Window>